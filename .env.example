# --- PhotoGram : configuration ---
# Copier en .env puis adapter.  Ne jamais committer .env.

# Mot de passe unique d'acces au site (LAN prive)
PHOTOGRAM_PASSWORD=change-moi

# Cle de signature des cookies de session.
# Generer avec :  python3 -c "import secrets; print(secrets.token_hex(32))"
PHOTOGRAM_SECRET_KEY=change-moi-aussi

# Repertoire de donnees (photos, bases, resultats).
# Sur RPi3 : viser un disque USB plutot que la carte SD si possible.
PHOTOGRAM_DATA_DIR=/var/lib/photogram

# Interface et port d'ecoute du serveur web
PHOTOGRAM_HOST=0.0.0.0
PHOTOGRAM_PORT=8000

# --- Garde-fous RPi3 (1 Go de RAM) ---
# Cote le plus long des images envoyees au pipeline (px).
# 1600 est un bon compromis sur RPi3 ; 2400+ = risque d'OOM.
PHOTOGRAM_WORK_MAX_DIM=1600
# Nombre maximum de photos retenues par reconstruction.
PHOTOGRAM_MAX_PHOTOS=40
# Taille maximale d'un fichier televerse (Mo)
PHOTOGRAM_MAX_UPLOAD_MB=40
# Nombre de threads utilises par les binaires du pipeline (RPi3 = 4 coeurs)
PHOTOGRAM_THREADS=3
# Conserver les fichiers intermediaires du pipeline (tres gourmand en disque)
PHOTOGRAM_KEEP_INTERMEDIATES=0

# --- Chaine de reconstruction ---
# auto    : OpenMVG+OpenMVS si la chaine est complete, sinon COLMAP (nuage epars)
# openmvg : force OpenMVG+OpenMVS (seule chaine allant jusqu'au maillage)
# colmap  : force COLMAP (nuage epars uniquement, mais installable via apt)
PHOTOGRAM_BACKEND=auto

# --- Binaires du pipeline ---
# Laisser vide pour une detection automatique dans le PATH.
# Dossiers contenant les executables, si ceux-ci ne sont pas dans le PATH.
# Utile sous Windows (archive decompressee) ou avec une installation manuelle.
PHOTOGRAM_OPENMVG_BIN=
PHOTOGRAM_OPENMVS_BIN=
PHOTOGRAM_COLMAP_BIN=

# COLMAP a-t-il ete compile avec CUDA ? Detecte automatiquement d'apres les
# bibliotheques presentes a cote de l'executable ; forcer avec 1 ou 0 si la
# detection se trompe. Sans CUDA, COLMAP s'arrete au nuage epars.
PHOTOGRAM_COLMAP_CUDA=auto

# Utiliser le GPU pour la detection des points caracteristiques (SIFT).
# Independant du reglage precedent : cette acceleration peut echouer la ou la
# densification fonctionne. Mettre 0 si l'etape « Detection des points
# caracteristiques » echoue ; le calcul sera plus lent mais fiable.
PHOTOGRAM_COLMAP_GPU=auto
PHOTOGRAM_SENSOR_DB=
